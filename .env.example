# Copia este archivo como .env.local y ajusta los valores.
# Nunca commitees .env.local (contiene secretos).

# Base de datos PostgreSQL (ver docker-compose.yml)
DATABASE_URL="postgresql://astra:astra@localhost:5432/astra_study?schema=public"

# Clave de API de IA. Solo vive en el servidor (backend), nunca en el cliente.
AI_API_KEY=""

# Proveedor de IA (stub local por defecto; Task 5 lo hace abstraído)
AI_PROVIDER="stub"

# Auth privada de un solo usuario (NextAuth v5, solo servidor)
ADMIN_EMAIL="estudio@local"
# Genera con: node scripts/seed-admin.mjs
ADMIN_PASSWORD_HASH=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

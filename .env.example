# Copia este archivo como .env.local y ajusta los valores.
# Nunca commitees .env.local (contiene secretos).

# Base de datos PostgreSQL.
# Local (docker-compose.yml): postgresql://astra:astra@localhost:5432/astra_study?schema=public
# Producción (Supabase): la URL de conexión "Direct" o "Connection pooling"
# con ?sslmode=require, por ejemplo:
# DATABASE_URL="postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://astra:astra@localhost:5432/astra_study?schema=public"

# Storage de archivos originales (lib/storage.ts, solo servidor).
# Producción: bucket de Supabase Storage (el bucket debe existir).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="files"
# Sin SUPABASE_URL/KEY, fallback a disco local bajo STORAGE_DIR.
STORAGE_DIR=".data/uploads"

# Clave de API de IA (OpenAI gpt-4o-mini vía fetch, sin SDK).
# Solo vive en el servidor (backend), nunca en el cliente.
OPENAI_API_KEY=""
# Opcional: endpoint compatible con OpenAI (p. ej. stub local para E2E/CI).
OPENAI_BASE_URL="https://api.openai.com/v1"

# Auth privada de un solo usuario (NextAuth v5, solo servidor)
ADMIN_EMAIL="estudio@local"
# Genera con: node scripts/seed-admin.mjs
ADMIN_PASSWORD_HASH=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
